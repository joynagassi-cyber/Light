rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isValidIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && isValidId(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /preferences/navigation {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.order is list
          && request.resource.data.order.size() >= 1 && request.resource.data.order.size() <= 12
          && request.resource.data.hidden is list
          && request.resource.data.hidden.size() <= 5
          && request.resource.data.icons is map
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /courses/{courseId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(courseId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(courseId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(courseId);
      }
      match /projects/{projectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(projectId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(projectId);
      }
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }
      match /focusProfiles/{profileId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(profileId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(profileId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(profileId);
      }
      match /focusSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(sessionId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }
      match /habits/{habitId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(habitId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(habitId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(habitId);
      }
      match /countdowns/{countdownId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(countdownId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(countdownId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(countdownId);
      }
      match /libraryFolders/{folderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(folderId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(folderId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(folderId);
      }
      match /libraryItems/{itemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(itemId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(itemId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(itemId);
      }
    }

    // Fallback deny for anything else – specific allows above take precedence.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
