<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#8D5CE6</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Light.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F7F5FF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/light_brand_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">#F7F5FF</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
