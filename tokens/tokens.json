{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "bg":               { "$type": "color", "$value": "#FFFFFF", "$description": "page background" },
    "surface":          { "$type": "color", "$value": "#F4F1EA" },
    "surface-2":        { "$type": "color", "$value": "#EAE6DC" },
    "text":             { "$type": "color", "$value": "#101319", "$description": "16.6:1 on bg" },
    "text-2":           { "$type": "color", "$value": "#343A46", "$description": "10.4:1 on bg" },
    "muted":            { "$type": "color", "$value": "#5B6170", "$description": "5.5:1 on surface" },
    "line":             { "$type": "color", "$value": "#E3DFD6" },
    "accent":           { "$type": "color", "$value": "#F0512B" },
    "on-accent":        { "$type": "color", "$value": "#101319", "$description": "5.3:1 on accent — never white" },
    "accent-ink":       { "$type": "color", "$value": "#B93314" },
    "accent-pressed":   { "$type": "color", "$value": "#A02C10" },
    "accent-soft":      { "$type": "color", "$value": "#FDE9E3" },
    "success":          { "$type": "color", "$value": "#0E7C6B" },
    "danger":           { "$type": "color", "$value": "#C62828" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "font": {
    "sans":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
    "display": { "$type": "fontFamily", "$value": ["Sora", "Inter", "sans-serif"] },
    "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
  },
  "text": {
    "sm":   { "$type": "dimension", "$value": "14px" },
    "base": { "$type": "dimension", "$value": "16px" },
    "lg":   { "$type": "dimension", "$value": "20px" },
    "xl":   { "$type": "dimension", "$value": "24px" },
    "2xl":  { "$type": "dimension", "$value": "32px" },
    "3xl":  { "$type": "dimension", "$value": "40px" },
    "4xl":  { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "16px" }
  }
}
